# Before the Smoke environment configuration
# Copy to .env and fill in. Never commit .env. All values are read by the
# backend only (server/); nothing here is ever sent to the browser.

# --- Optional: NASA FIRMS MAP_KEY (free) -------------------------------------
# Satellite fire detections (VIIRS/MODIS) with fire radiative power.
# Without it, the app uses CWFIS hotspots (last 24 h, no key needed).
# Get one: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# FIRMS product used for near-real-time detections.
# One of: VIIRS_SNPP_NRT, VIIRS_NOAA20_NRT, VIIRS_NOAA21_NRT, MODIS_NRT
FIRMS_SOURCE=VIIRS_NOAA20_NRT

# --- Optional: Anthropic API key ---------------------------------------------
# Lets the assistant answer free-form questions with Claude. Without it, the
# built-in answers are used. Untested against the live API.
ANTHROPIC_API_KEY=

# --- Server ------------------------------------------------------------------
PORT=8787
# Mode the UI starts in: "live" (real upstream data) or "sim" (labelled simulated scenario)
DEFAULT_MODE=live
# Upstream cache lifetime in seconds
CACHE_TTL_SECONDS=600
